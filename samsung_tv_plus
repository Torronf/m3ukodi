function create_htaccess() {
    $htaccess_path = __DIR__ . '/.htaccess'; // Ruta donde se guardará el archivo .htaccess (en el directorio actual)
    $base_path = dirname($_SERVER['PHP_SELF']);
    
    // Verifica si el archivo .htaccess ya existe
    if (!file_exists($htaccess_path)) {
        // Contenido que quieres que tenga el archivo .htaccess
        $htaccess_content = <<<EOT
                        RewriteEngine On
                        RewriteBase $base_path
                        RewriteRule ^(?!.*\.php$)(.*)$ $base_path/index.php [QSA,L]
                    EOT;

        // Escribe el contenido al archivo .htaccess
        file_put_contents($htaccess_path, $htaccess_content);

        echo "El archivo .htaccess ha sido creado exitosamente.\n";
    } else {
        echo "El archivo .htaccess ya existe.\n";
    }
}

// Función para obtener datos de la API de canales
function get_app_data() {
    global $cache_dir;

    // Ruta de la caché (usando la URL codificada en base64)
    $cache_path = $cache_dir . '/' . base64_encode(APP_URL);

    // Verificar si ya existe una versión en caché y si no ha caducado
    if (file_exists($cache_path) && (filemtime($cache_path) + CACHE_TIME > time())) {
        return json_decode(file_get_contents($cache_path), true);
    }

    // Descargar el archivo comprimido
    $response = @file_get_contents(APP_URL);
    if ($response === FALSE) {
        error_log("Error al obtener datos de " . APP_URL);
        die("Error al obtener datos de la API.");
    }

    // Descomprimir el archivo .gz
    $data = json_decode(gzdecode($response), true);
    if ($data === NULL) {
        error_log("Error al decodificar el archivo JSON.");
        die("Error al decodificar el archivo JSON.");
    }

    // Guardar los datos descomprimidos en la caché
    file_put_contents($cache_path, json_encode($data));

    return $data;
}
//Generacion de Lista por Region
function serve_playlist($params) {
    $all_channels = get_app_data()['regions'];
    $regions = isset($params['regions']) ? explode(',', $params['regions']) : [REGION_ALL];
    $groups = isset($params['groups']) ? explode(',', $params['groups']) : [];
    $start_chno = isset($params['start_chno']) ? (int)$params['start_chno'] : null;
    $sort = isset($params['sort']) ? $params['sort'] : 'chno';

    echo "#EXTM3U\n";

    // Si $regions contiene 'all', no filtramos por regiones
    $channels = [];
    if (in_array('all', $regions)) {
        // Agregar todos los canales de todas las regiones
        foreach ($all_channels as $region => $region_data) {
            $channels = array_merge($channels, $region_data['channels']);
        }
    } else {
        // Si no es 'all', filtramos por las regiones especificadas
        foreach ($regions as $region) {
            if (isset($all_channels[$region])) {
                $channels = array_merge($channels, $all_channels[$region]['channels']);
            }
        }
    }

    // Si hay un parámetro 'groups', filtramos los canales por los grupos especificados
    if (!empty($groups)) {
        $channels = array_filter($channels, function($channel) use ($groups) {
            return in_array(strtolower($channel['group']), array_map('strtolower', $groups));
        });
    }

    // Ordenar los canales según el parámetro 'sort' (por número de canal o nombre)
    uasort($channels, function($a, $b) use ($sort) {
        if ($sort == 'chno') {
            return $a['chno'] <=> $b['chno'];
        }
        return strcmp(strtolower($a['name']), strtolower($b['name']));
    });

    // Mostrar la lista de canales
    foreach ($channels as $key => $channel) {
        if (isset($params['exclude']) && in_array($key, explode(',', $params['exclude']))) {
            continue;
        }
        if (isset($params['include']) && !in_array($key, explode(',', $params['include']))) {
            continue;
        }

        $chno = $start_chno ? 'tvg-chno="' . $start_chno . '"' : '';
        if ($start_chno) {
            $start_chno++;
        }

      // Reemplazar {id} en la URL con el valor de $key
            $playback_url = str_replace('{id}', $key, PLAYBACK_URL);

            // Definir el nombre del grupo y los logos
            $groups_m3u = "SAMSUNG TV PLUS";
            $group_logo = "https://www.google.com/s2/favicons?domain=samsung.com&sz=256";
            // Construcción del archivo M3U
            $m3u_content = "#EXTGRP:{$groups_m3u}\n";
            // Si el logo está vacío, usamos un logo por defecto en su lugar
            $tvg_logo = !empty($channel['logo']) ? $channel['logo'] : 'https://tinyurl.com/logom3ukodi';

            // Construir la entrada de M3U con todos los parámetros
            $m3u_content .= "#EXTINF:-1 channel-id=\"samsung-$key\" tvg-id=\"$key\" tvg-logo=\"$tvg_logo\" group-logo=\"$group_logo\" group-title=\"{$groups_m3u}\" $chno,{$channel['group']}-{$channel['name']}\n";
            $m3u_content .= $playback_url . "\n";

            // Imprimir el contenido de la lista de reproducción M3U
            echo $m3u_content;

    }
}
// Función para servir el archivo EPG (guía electrónica de programas)
function serve_epg($params) {
    // Verificar si el parámetro 'regions' está presente y es un único valor
    if (isset($params['regions'])) {
        $regions = explode(',', $params['regions']);
        
        // Si hay más de una región, retornamos un error
        if (count($regions) > 1) {
            die("Error: solo se permite una región. Ejemplo correcto: ?regions=es");
        }

        // Si hay una sola región, asignarla
        $region = $regions[0];
    } else {
        // Si no se especifica, usar la constante por defecto
        $region = REGION_ALL;
    }

    // Reemplazar la variable {region} en la URL
    $url = str_replace('{region}', $region, EPG_URL);

    // Ruta de caché basada en la URL
    $cache_path = sys_get_temp_dir() . '/' . base64_encode($url);
    
    // Si ya existe una caché válida, servirla
    if (file_exists($cache_path)) {
        header('Content-Type: application/xml');
        echo file_get_contents($cache_path);
        return;
    }

    // Obtener el contenido desde la URL
    $response = file_get_contents($url);
    if ($response === FALSE) {
        die("Error al obtener el archivo EPG desde $url");
    }

    // Descomprimir el contenido si es necesario
    $xml = gzdecode($response);

    // Guardar el archivo descomprimido en la caché
    file_put_contents($cache_path, $xml);

    // Servir el archivo EPG
    header('Content-Type: application/xml');
    echo $xml;
}

// Limpiar caché
function clear_cache() {
    global $cache_dir;
    array_map('unlink', glob("$cache_dir/*"));
    echo "Cache cleared\n";
}
// Función para manejar las solicitudes HTTP
function handle_request() {
       // Obtener la URL completa (protocolo, dominio y ruta)
    $server = "{$_SERVER['REQUEST_SCHEME']}://{$_SERVER['HTTP_HOST']}{$_SERVER['REQUEST_URI']}";
    $path = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);
    $params = [];
    parse_str(parse_url($_SERVER['REQUEST_URI'], PHP_URL_QUERY), $params);

    // Asegurarse de que las rutas coincidan correctamente
    switch (true) {
        case strpos($path, BASE_PATH . '/' . PLAYLIST_PATH) === 0: //http://tu-dominio.com/playlist.m3u8?regions=us&groups=News
            serve_playlist($params);
            break;
        case strpos($path, BASE_PATH . '/' . EPG_PATH) === 0: //http://tu-dominio.com/epg.xml?regions=us
            serve_epg($params);
            break;
        case strpos($path, BASE_PATH . '/' . CLEAR_CACHE_PATH) === 0: //http://tu-dominio.com/clear_cache
            clear_cache();
            break;
       default:
            header("HTTP/1.0 404 Not Found");
            echo "Código: 404 Not Found\n\n";

            echo "Ejemplo de Uso:\n";
            echo "Las siguientes solicitudes podrían funcionar:\n\n";
            echo "  ".$server."playlist.m3u8?regions=es&groups=Noticias\n";
            echo "  ".$server."epg.xml?regions=es\n";
            echo "  ".$server."clear_cache\n\n";

            echo "Parámetros de la URL:\n\n";

            // regions
            echo "regions\n";
            echo "  Las regiones de los canales que deseas incluir.\n";
            echo "  Sustituye la variable de entorno REGIONS si está presente.\n\n";
            echo "  Ejemplo: /playlist.m3u8?regions=us,ca\n";
            echo "  Regiones Disponibles: at, ca, ch, de, es, fr, gb, in, it, kr, us\n\n";

            // groups
            echo "groups\n";
            echo "  Los grupos que deseas incluir.\n";
            echo "  Sustituye la variable de entorno GROUPS si está presente.\n\n";
            echo "  Ejemplo: /playlist.m3u8?regions=us&groups=Kids,Comedy\n\n";

            // start_chno
            echo "start_chno\n";
            echo "  Un número de canal desde el cual deseas comenzar a numerar los canales.\n";
            echo "  Ejemplo: /playlist.m3u8?start_chno=50\n\n";

            // include
            echo "include\n";
            echo "  Lista separada por comas de los channel-id que SÓLO deseas incluir en la lista de reproducción.\n";
            echo "  Ejemplo: /playlist.m3u8?include=samsung-USBB2900003O3,samsung-US26000201N\n\n";

            // exclude
            echo "exclude\n";
            echo "  Lista separada por comas de los channel-id que NO deseas incluir en la lista de reproducción.\n";
            echo "  Ejemplo: /playlist.m3u8?exclude=samsung-USBB2900003O3,samsung-US26000201N\n\n";

            // Combinación de parámetros
            echo "Y por supuesto, puedes combinar los parámetros de la consulta:\n";
            echo "  Ejemplo: /playlist.m3u8?start_chno=50&include=samsung-USBB2900003O3&exclude=samsung-US26000201N\n";

            break;
    }
}

